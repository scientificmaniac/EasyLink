contacts.db
contacts.db-journal
contacts.db-wal

# 导出产物（由「数据导出」按钮生成）
contacts.txt
contacts.md
contacts.xlsx

# 数据修复备份
contacts.json.*.bak

# 日志
*.log
logs/
